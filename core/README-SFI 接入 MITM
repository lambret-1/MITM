### MITM Service 配置

```json
{
  "services": [
    {
      "type": "mitm",
      "tag": "mitm",
      "enabled": true,
      "ca": {
        "certificate": "/var/jb/etc/sing-box/ca.pem",
        "private_key": "/var/jb/etc/sing-box/ca.key"
      },
      "match": {
        "domain_suffix": ["example.com", "example.net"]
      },
      "rewrite": {
        "enabled": true,
        "max_body_size": 10485760,
        "rules": [
          {
            "domain_suffix": ["example.com"],
            "response_header": {"X-MITM": "sing-box"}
          }
        ]
      },
      "on_error": "bypass",
      "upstream_timeout": 30
    }
  ]
}
